#include <stdio.h>

void merge(int a[], int l, int m, int h) {
    int i=l, j=m+1, k=0, b[50];
    while(i<=m && j<=h) b[k++] = a[i]<a[j] ? a[i++] : a[j++];
    while(i<=m) b[k++] = a[i++];
    while(j<=h) b[k++] = a[j++];
    for(i=l,k=0;i<=h;i++,k++) a[i]=b[k];
}

void ms(int a[], int l, int h) {
    if(l<h) {
        int m=(l+h)/2;
        ms(a,l,m);
        ms(a,m+1,h);
        merge(a,l,m,h);
    }
}

int main() {
    int n;
    printf("Enter array size: ");
    scanf("%d", &n);
    int a[n];
    printf("Enter %d elements:\n",n);
    for(int i=0;i<n;i++) scanf("%d",&a[i]);

    ms(a,0,n-1);

    printf("Sorted using Merge Sort:\n");
    for(int i=0;i<n;i++) printf("%d ",a[i]);
    printf("\nCompleted ✅");
}
