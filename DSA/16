#include <stdio.h>
#define MAX 5

int stack[MAX], top = -1;

void push(int v) {
    if (top == MAX - 1) printf("Stack Overflow\n");
    else stack[++top] = v;
}

int pop() {
    if (top == -1) printf("Stack Underflow\n"), return -1;
    return stack[top--];
}

int peek() {
    if (top == -1) return -1;
    return stack[top];
}

void display() {
    if (top == -1) printf("Empty Stack\n");
    else {
        for (int i = top; i >= 0; i--)
            printf("| %d |\n", stack[i]);
        printf("-----\n");
    }
}

int main() {
    push(10); push(20); push(30);
    printf("Popped: %d\n", pop());
    printf("Top: %d\n", peek());
    printf("Peek: %d\n", peek());
    printf("\nStack Elements:\n");
    display();
}
