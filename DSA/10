#include <stdio.h>
#include <stdlib.h>

struct node {
    int data;
    struct node *prev, *next;
};

int main() {
    struct node *head=NULL, *new1, *temp, *last;
    int choice=1, val;

    // Create + Insert at end
    while(choice) {
        new1 = (struct node*)malloc(sizeof(struct node));
        printf("Enter value: ");
        scanf("%d",&val);
        new1->data = val;
        new1->prev = new1->next = NULL;
        if(head==NULL) head = last = new1;
        else { last->next = new1; new1->prev = last; last = new1; }
        printf("Continue? (1/0): ");
        scanf("%d",&choice);
    }

    printf("\nDLL Forward Traversal:\n");
    for(temp=head;temp!=NULL;temp=temp->next)
        printf("%d ↔ ",temp->data);
    printf("NULL\n");

    printf("\nDLL Backward Traversal:\n");
    for(temp=last;temp!=NULL;temp=temp->prev)
        printf("%d ↔ ",temp->data);
    printf("NULL\n");

    printf("\nProcess Completed ✅");
    return 0;
}
